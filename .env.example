# Leave LLM_PROVIDER as offline to run with no model (templates and keyword methods).
# Options: offline | openai | azure_openai | gemini | anthropic | gateway
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
# gateway only: the bank's internal, OpenAI-compatible endpoint
LLM_BASE_URL=
# azure_openai only
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
